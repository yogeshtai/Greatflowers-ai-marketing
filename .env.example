# Server Configuration
PORT=3000

# Google Analytics 4
GA4_PROPERTY_ID=your_ga4_property_id_here
# Absolute path to the GA4 service-account JSON (see "Google Analytics Setup" in the README)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/ga4-service-account.json

# Meta (Facebook page + linked Instagram business account)
META_PAGE_ID=your_facebook_page_id_here
META_INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here
# Long-lived Page access token (type PAGE) with pages_manage_posts and instagram_content_publish
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
# META_GRAPH_VERSION=v25.0
# Minimum spacing between any Instagram posts, including manual posts. Set 0 to disable.
# INSTAGRAM_MIN_POST_GAP_HOURS=12

# S3 (campaign and creative images)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
AWS_S3_BUCKET=greatflowers
# Key prefixes for creative and campaign images (both default to "campaign")
# AWS_S3_CREATIVE_PREFIX=campaign
# AWS_S3_CAMPAIGN_PREFIX=campaign

# Hermes AI Configuration
# HERMES_API_URL=http://127.0.0.1:8642/v1/chat/completions
HERMES_API_KEY=your_hermes_api_key_here
# Optional usage limits (defaults shown)
# HERMES_TIMEOUT_MS=600000
# Entire two-stage campaign recommendation deadline. Defaults to 2x HERMES_TIMEOUT_MS + 1 minute.
# RECOMMENDATION_PIPELINE_TIMEOUT_MS=1260000
# CODEX_TIMEOUT_MS=480000
# CODEX_REASONING_EFFORT=
# CODEX_MODEL=

# Great Flowers admin API (blog publishing). Use the staging URL until the flow is proven.
GF_ADMIN_API_URL=
GF_ADMIN_EMAIL=
GF_ADMIN_PASSWORD=
# Public storefront base, used for links inside posts and the live post URL (defaults to https://greatflowers.net)
# GF_STOREFRONT_URL=
# Posts are created hidden (status 0) unless this is "true"
# BLOG_PUBLISH_LIVE=false
# "immediate" (default) publishes a post the moment it is approved; "scheduled" waits for the daily slot below
# BLOG_PUBLISH_MODE=immediate
# Set to "false" to stop the 6 PM IST daily draft
# BLOG_AUTOGENERATE=true
# Set to "false" to leave scheduled drafts waiting for manual approval
# BLOG_AUTOAPPROVE=true
# Scheduled drafts take their title from the Blog Queue's title list when it has a ready title
# (and plan a post from the occasion calendar otherwise). Set to "false" to ignore the list.
# BLOG_TITLE_LIST=true
# Hour (America/New_York) approved posts go live when BLOG_PUBLISH_MODE=scheduled
# BLOG_PUBLISH_HOUR_ET=10

# Flower Wiki automation (draft generated daily at 7 PM IST)
# Wiki entries are created hidden (status 0) unless this is "true"
# WIKI_PUBLISH_LIVE=false
# "immediate" (default) publishes an entry when approved; "scheduled" waits for the daily slot below
# WIKI_PUBLISH_MODE=immediate
# Set to "false" to stop the 7 PM IST daily wiki draft
# WIKI_AUTOGENERATE=true
# Set to "false" to leave scheduled entries waiting for manual approval
# WIKI_AUTOAPPROVE=true
# Hour (America/New_York) approved entries publish when WIKI_PUBLISH_MODE=scheduled
# WIKI_PUBLISH_HOUR_ET=10

# Great Flowers Article automation (draft generated daily at 6:30 PM IST)
# Articles are created hidden (status 0) unless this is "true"
# ARTICLE_PUBLISH_LIVE=false
# "immediate" (default) publishes an article when approved; "scheduled" waits for the daily slot below
# ARTICLE_PUBLISH_MODE=immediate
# Set to "false" to stop the 6:30 PM IST daily article draft
# ARTICLE_AUTOGENERATE=true
# Set to "false" to leave scheduled articles waiting for manual approval
# ARTICLE_AUTOAPPROVE=true
# Hour (America/New_York) approved articles publish when ARTICLE_PUBLISH_MODE=scheduled
# ARTICLE_PUBLISH_HOUR_ET=10

# Note: Also place your GA4 service account JSON file as 'ga4-service-account.json' in the root directory

# ─────────────────────────────────────────────────────────────────────────────
# Projects (brands)
# Everything above belongs to GreatFlowers, the default project. Other brands use
# the same settings with their own prefix: GF_ADMIN_API_URL -> OPF_ADMIN_API_URL,
# META_PAGE_ID -> OPF_META_PAGE_ID, BLOG_PUBLISH_LIVE -> OPF_BLOG_PUBLISH_LIVE, ...
# Hermes, Codex and PORT stay shared. See src/projects/.
# Check a brand's settings with: npm run check:project -- onepriceflowers
# ─────────────────────────────────────────────────────────────────────────────

# One Price Flowers stays off until this is "true"
# OPF_ENABLED=false

# Storefront admin API (blogs, wikis, articles)
# OPF_ADMIN_API_URL=https://api.onepriceflowers.com/api/admin
# OPF_ADMIN_EMAIL=
# OPF_ADMIN_PASSWORD=
# OPF_STOREFRONT_URL=https://www.onepriceflowers.com

# Meta (Facebook page + linked Instagram business account)
# OPF_META_PAGE_ID=
# OPF_META_INSTAGRAM_ACCOUNT_ID=
# OPF_META_PAGE_ACCESS_TOKEN=
# OPF_META_GRAPH_VERSION=v25.0
# OPF_INSTAGRAM_MIN_POST_GAP_HOURS=12

# GA4 (optional). Leave the credentials file empty to use the GreatFlowers service account,
# and give it Viewer access on the One Price Flowers GA4 property.
# OPF_GA4_PROPERTY_ID=
# OPF_GOOGLE_APPLICATION_CREDENTIALS=

# S3: oneflowers-prod is the live storefront bucket; marketing images stay in marketing/campaign/
# (a prefix of "public" or an empty prefix is refused)
# OPF_AWS_S3_BUCKET=oneflowers-prod
# OPF_AWS_REGION=us-east-1
# OPF_AWS_ACCESS_KEY_ID=
# OPF_AWS_SECRET_ACCESS_KEY=
# OPF_AWS_S3_CREATIVE_PREFIX=marketing/campaign
# OPF_AWS_S3_CAMPAIGN_PREFIX=marketing/campaign

# Automation: the same switches as GreatFlowers. Values below are the safe first launch
# (no timed drafts, published items hidden). To run like GreatFlowers, set the
# *_AUTOGENERATE and *_PUBLISH_LIVE values to "true".
# Timed drafts: blog Mon/Wed/Fri 2:00 PM IST, wiki Tue/Thu/Sat 2:30 PM IST, article Sunday 2:00 PM IST.
# OPF_BLOG_AUTOGENERATE=false
# OPF_BLOG_AUTOAPPROVE=true
# OPF_BLOG_TITLE_LIST=true
# OPF_BLOG_PUBLISH_LIVE=false
# OPF_BLOG_PUBLISH_MODE=immediate
# OPF_BLOG_PUBLISH_HOUR_ET=10
# OPF_WIKI_AUTOGENERATE=false
# OPF_WIKI_AUTOAPPROVE=true
# OPF_WIKI_PUBLISH_LIVE=false
# OPF_WIKI_PUBLISH_MODE=immediate
# OPF_WIKI_PUBLISH_HOUR_ET=10
# OPF_ARTICLE_AUTOGENERATE=false
# OPF_ARTICLE_AUTOAPPROVE=true
# OPF_ARTICLE_PUBLISH_LIVE=false
# OPF_ARTICLE_PUBLISH_MODE=immediate
# OPF_ARTICLE_PUBLISH_HOUR_ET=10
