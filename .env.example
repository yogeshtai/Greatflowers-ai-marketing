# Server Configuration
PORT=3000

# Google Analytics 4
GA4_PROPERTY_ID=your_ga4_property_id_here

# Meta (Facebook/Instagram) Configuration
META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=your_meta_ad_account_id_here
# Minimum spacing between any Instagram posts, including manual posts. Set 0 to disable.
# INSTAGRAM_MIN_POST_GAP_HOURS=12

# Hermes AI Configuration
HERMES_API_KEY=your_hermes_api_key_here
# Optional usage limits (defaults shown)
# HERMES_TIMEOUT_MS=600000
# Entire two-stage campaign recommendation deadline. Defaults to 2x HERMES_TIMEOUT_MS + 1 minute.
# RECOMMENDATION_PIPELINE_TIMEOUT_MS=1260000
# CODEX_TIMEOUT_MS=480000
# CODEX_REASONING_EFFORT=
# CODEX_MODEL=

# Great Flowers admin API (blog publishing). Use the staging URL until the flow is proven.
GF_ADMIN_API_URL=
GF_ADMIN_EMAIL=
GF_ADMIN_PASSWORD=
# Public storefront base, used for links inside posts and the live post URL (defaults to https://greatflowers.net)
# GF_STOREFRONT_URL=
# Posts are created hidden (status 0) unless this is "true"
# BLOG_PUBLISH_LIVE=false
# "immediate" (default) publishes a post the moment it is approved; "scheduled" waits for the daily slot below
# BLOG_PUBLISH_MODE=immediate
# Set to "false" to stop the 6 PM IST daily draft
# BLOG_AUTOGENERATE=true
# Hour (America/New_York) approved posts go live when BLOG_PUBLISH_MODE=scheduled
# BLOG_PUBLISH_HOUR_ET=10

# Flower Wiki automation (draft generated daily at 7 PM IST)
# Wiki entries are created hidden (status 0) unless this is "true"
# WIKI_PUBLISH_LIVE=false
# "immediate" (default) publishes an entry when approved; "scheduled" waits for the daily slot below
# WIKI_PUBLISH_MODE=immediate
# Set to "false" to stop the 7 PM IST daily wiki draft
# WIKI_AUTOGENERATE=true
# Hour (America/New_York) approved entries publish when WIKI_PUBLISH_MODE=scheduled
# WIKI_PUBLISH_HOUR_ET=10

# Great Flowers Article automation (draft generated daily at 6:30 PM IST)
# Articles are created hidden (status 0) unless this is "true"
# ARTICLE_PUBLISH_LIVE=false
# "immediate" (default) publishes an article when approved; "scheduled" waits for the daily slot below
# ARTICLE_PUBLISH_MODE=immediate
# Set to "false" to stop the 6:30 PM IST daily article draft
# ARTICLE_AUTOGENERATE=true
# Hour (America/New_York) approved articles publish when ARTICLE_PUBLISH_MODE=scheduled
# ARTICLE_PUBLISH_HOUR_ET=10

# Note: Also place your GA4 service account JSON file as 'ga4-service-account.json' in the root directory
