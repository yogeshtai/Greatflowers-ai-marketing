# Server Configuration
PORT=3000

# Google Analytics 4
GA4_PROPERTY_ID=your_ga4_property_id_here

# Meta (Facebook/Instagram) Configuration
META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=your_meta_ad_account_id_here

# Hermes AI Configuration
HERMES_API_KEY=your_hermes_api_key_here
# Optional usage limits (defaults shown)
# HERMES_TIMEOUT_MS=600000
# CODEX_TIMEOUT_MS=480000
# CODEX_REASONING_EFFORT=
# CODEX_MODEL=

# Great Flowers admin API (blog publishing). Use the staging URL until the flow is proven.
GF_ADMIN_API_URL=
GF_ADMIN_EMAIL=
GF_ADMIN_PASSWORD=
# Public storefront base, used only to record the live post URL (e.g. https://greatflowers.net)
# GF_STOREFRONT_URL=
# Posts are created hidden (status 0) unless this is "true"
# BLOG_PUBLISH_LIVE=false
# Set to "false" to stop the 7 PM IST daily draft
# BLOG_AUTOGENERATE=true
# Hour (America/New_York) approved posts go live
# BLOG_PUBLISH_HOUR_ET=10

# Note: Also place your GA4 service account JSON file as 'ga4-service-account.json' in the root directory
